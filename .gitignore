*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

artifacts/

# Prepublication: keep local credentials, caches and unused assets out of Git.
.env
.env.*
!.env.example
__pycache__/
*.pyc
.agents/
src/assets/hero.png
